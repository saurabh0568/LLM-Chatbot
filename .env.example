LLM_API_KEYS=replace_with_provider_key_1,replace_with_provider_key_2
LLM_MODEL=gemini/gemini-flash-lite-latest
LLM_MODELS=gemini/gemini-flash-lite-latest,groq/openai/gpt-oss-120b
DATABASE_URL=sqlite:///./data/app.db
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
ENABLE_FAILURE_SIMULATION=true
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.
LLM_MOCK_RESPONSE=Local mock answer for verification
LLM_MAX_TOKENS=1024
LLM_REQUEST_TIMEOUT=30
CACHE_TTL_SECONDS=3600
BACKEND_PORT=8000
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000
